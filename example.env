PORT=3000
DATABASE_URL=file:./data/destinations.db
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- RC Rally upstream (game-heavywater) --------------------------------------
# Times, parts, objectives and loadouts are written by game-heavywater; the GDO
# reads served here fetch them back from its /internal/rcrally/* endpoint, which
# only accepts callers inside RCRALLY_INTERNAL_ALLOW (Docker/loopback).
# HEAVYWATER_BASE_URL=http://127.0.0.1:30086

# HEAVYWATER_TIMEOUT_MS=3000
# HEAVYWATER_CACHE_MS=15000

# Set to 1 to get real 404s back instead of the destinations-list passthrough.
# DESTINATIONS_STRICT_404=0

# --- Wardrobe Wars -----------------------------------------------------------
# All optional. The defaults land inside the same /app/data volume the SQLite
# file uses, so photos persist with no extra mount.

# WW_PHOTO_ROOT=data/wardrobewars/photos
# WW_PRIZE_TILE_DIR=data/wardrobewars/prizes

# Point at the CDN's WardrobeWars/Images tree to import the surviving 2012
# entries and the 13 original prize tiles the first time the service starts.
# WW_SEED_DIR=/srv/destinationhome/cdn/WardrobeWars/Images

# Contest day/week/month boundaries. The 2012 rules ran on Pacific time.
# WW_TIMEZONE=America/Los_Angeles

# One theme per contest week, pipe-separated.
# WW_THEMES=Black and white|Summer holiday|Formal night out
