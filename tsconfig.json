  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "types": ["bun-types"],
    "paths": {
      "@main": ["./src/index.ts"],
      "@db": ["./src/db/index.ts"],
